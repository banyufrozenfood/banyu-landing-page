# Salin file ini menjadi .env lalu isi nilainya.
# Di Vercel, isi lewat Project Settings → Environment Variables.

# URL project Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/publishable key (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Opsional: batasi siapa yang boleh masuk panel admin.
# Pisahkan dengan koma. Jika dikosongkan, semua user terautentikasi diizinkan.
VITE_ADMIN_EMAILS=admin@contoh.com
